#!/bin/sh
# Open-Box sing-box 内核在 Container 容器环境下的服务控制脚本
# 支持 RouterOS 7.x 容器环境以及标准 Docker / Podman 容器
# 提供 start / stop / restart / status / enable / disable / enabled 动作

ACTION="$1"
if [ -d "/opt/ROS-Box" ]; then
  OPENBOX_ROOT="/opt/ROS-Box"
else
  OPENBOX_ROOT="/opt/open-box"
fi
BIN="$OPENBOX_ROOT/bin/sing-box"
CONF="$OPENBOX_ROOT/etc/config.json"
DATA="$OPENBOX_ROOT/data"
PID_FILE="$DATA/sing-box.pid"
LOG_FILE="$DATA/sing-box.log"
AUTOSTART_FILE="$DATA/autostart"
NFT_TABLE="inet openbox"
SINGBOX_OUTPUT_MARK="0x2024"
OPENBOX_PASS_MARK="0x02000000"
OPENBOX_MARK_RULE_PREF="8999"
OPENBOX_PASS_RULE_PREF="8998"
OPENBOX_PASS_SKIP_TO="9010"
OPENBOX_PASS_LAST_PREF="32768"

mkdir -p "$DATA"

# 1. 修复 RouterOS 7.22+ 容器默认 ip rule 优先级冲突
# RouterOS 7.22+ 默认在容器内注入了 1: local, 2: main, 3: default 高优先级规则，
# 导致 sing-box 自动添加的策略路由无法被匹配。必须删除 1/2/3 规则并重设为标准优先级。
fix_ros_ip_rules() {
  command -v ip >/dev/null 2>&1 || return 0
  while ip rule show | grep -Eq '^(1|2|3):\s+from all lookup (local|main|default)'; do
    pref=$(ip rule show | grep -E '^(1|2|3):\s+from all lookup (local|main|default)' | head -n1 | cut -d: -f1)
    ip rule del pref "$pref" 2>/dev/null || break
  done
  while ip rule show | grep -Eq 'pref (32767|2147483646|2147483647) .*lookup (main|default)'; do
    pref=$(ip rule show | grep -E 'pref (32767|2147483646|2147483647) .*lookup (main|default)' | head -n1 | cut -d: -f1)
    ip rule del pref "$pref" 2>/dev/null || break
  done
  ip rule show | grep -Eq 'pref 200 .*lookup local' || ip rule add pref 200 from all lookup local 2>/dev/null || true
  ip rule show | grep -Eq 'pref 32766 .*lookup main' || ip rule add pref 32766 from all lookup main 2>/dev/null || true
  ip rule show | grep -Eq 'pref 32770 .*lookup default' || ip rule add pref 32770 from all lookup default 2>/dev/null || true
}

# 2. 确保 /dev/net/tun 字符设备存在
ensure_tun_device() {
  if [ ! -c /dev/net/tun ]; then
    mkdir -p /dev/net
    mknod /dev/net/tun c 10 200 2>/dev/null || true
    chmod 666 /dev/net/tun 2>/dev/null || true
  fi
}

# 3. 开启 IPv4 / IPv6 转发并放行防火墙
enable_forwarding() {
  echo 1 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true
  echo 1 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || true
  for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 > "$i" 2>/dev/null || true; done
  for i in /proc/sys/net/ipv4/conf/*/send_redirects; do echo 0 > "$i" 2>/dev/null || true; done
  [ -f /proc/sys/net/core/rmem_max ] && echo 16777216 > /proc/sys/net/core/rmem_max 2>/dev/null || true
  [ -f /proc/sys/net/core/wmem_max ] && echo 16777216 > /proc/sys/net/core/wmem_max 2>/dev/null || true
  echo "4096 87380 16777216" > /proc/sys/net/ipv4/tcp_rmem 2>/dev/null || true
  echo "4096 65536 16777216" > /proc/sys/net/ipv4/tcp_wmem 2>/dev/null || true
  echo 3 > /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null || true
  echo 1 > /proc/sys/net/ipv4/tcp_window_scaling 2>/dev/null || true
  echo bbr > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || true
  ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true
  if command -v iptables >/dev/null 2>&1; then
    iptables -P FORWARD ACCEPT 2>/dev/null || true
    iptables -C FORWARD -j ACCEPT 2>/dev/null || iptables -I FORWARD -j ACCEPT 2>/dev/null || true
    iptables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
      iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
  fi
}

# 4. 旁路由模式下的 NAT MASQUERADE (确保经过容器转发直连 RouterOS 的流量正确回包)
ensure_nat_masquerade() {
  if command -v iptables >/dev/null 2>&1; then
    default_dev=$(ip route show default 2>/dev/null | awk '/default/ {print $5}' | head -n1)
    [ -z "$default_dev" ] && default_dev="OpenBox"
    iptables -t nat -C POSTROUTING -o "$default_dev" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -o "$default_dev" -j MASQUERADE 2>/dev/null || true
  fi
}

# 5. 清理残留与应用标记策略路由
openbox_clean_stale_nft() {
  command -v nft >/dev/null 2>&1 || return 0
  if ! pgrep -x sing-box >/dev/null 2>&1; then
    nft delete table inet sing-box >/dev/null 2>&1 || true
  fi
}

openbox_apply_mark_rule() {
  command -v ip >/dev/null 2>&1 || return 0
  openbox_clear_mark_rule
  ip rule add pref $OPENBOX_MARK_RULE_PREF fwmark $SINGBOX_OUTPUT_MARK lookup main >/dev/null 2>&1 || true
  ip -6 rule add pref $OPENBOX_MARK_RULE_PREF fwmark $SINGBOX_OUTPUT_MARK lookup main >/dev/null 2>&1 || true
  for _ob_ip in "ip" "ip -6"; do
    $_ob_ip rule add pref $OPENBOX_PASS_RULE_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK goto $OPENBOX_PASS_SKIP_TO >/dev/null 2>&1 || true
    $_ob_ip rule add pref $OPENBOX_PASS_LAST_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK unreachable >/dev/null 2>&1 || true
  done
}

openbox_clear_mark_rule() {
  command -v ip >/dev/null 2>&1 || return 0
  while ip rule del pref $OPENBOX_MARK_RULE_PREF >/dev/null 2>&1; do :; done
  while ip -6 rule del pref $OPENBOX_MARK_RULE_PREF >/dev/null 2>&1; do :; done
  for _ob_ip in "ip" "ip -6"; do
    while $_ob_ip rule del pref $OPENBOX_PASS_RULE_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK >/dev/null 2>&1; do :; done
    while $_ob_ip rule del pref $OPENBOX_PASS_LAST_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK unreachable >/dev/null 2>&1; do :; done
  done
}

openbox_apply_nft() {
  command -v nft >/dev/null 2>&1 || return 0
  nft delete table $NFT_TABLE >/dev/null 2>&1 || true
  ENTRY_BYPASS="$OPENBOX_ROOT/etc/entry-bypass.nft"
  if [ -s "$ENTRY_BYPASS" ]; then
    {
      echo "table $NFT_TABLE {"
      cat "$ENTRY_BYPASS"
      echo "}"
    } | nft -f - >/dev/null 2>&1 || true
  fi
}

start_core() {
  if [ ! -x "$BIN" ]; then
    echo "openbox: sing-box binary not found at $BIN" >&2
    exit 1
  fi
  if [ ! -f "$CONF" ]; then
    echo "openbox: config not found at $CONF" >&2
    exit 1
  fi

  stop_core_quiet

  fix_ros_ip_rules
  ensure_tun_device
  enable_forwarding
  ensure_nat_masquerade
  openbox_clean_stale_nft
  openbox_apply_nft
  openbox_apply_mark_rule

  # 日志防爆盘保护：超过 5MB 滚动裁剪为最近 1000 行
  if [ -f "$LOG_FILE" ]; then
    log_sz=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$log_sz" -gt 5242880 ]; then
      tail -n 1000 "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
    fi
  fi

  echo "[openbox] Starting sing-box (GOMEMLIMIT=60MiB, GOGC=30, madvdontneed=1)..."
  export GOMEMLIMIT=60MiB
  export GOGC=30
  export GODEBUG=madvdontneed=1
  "$BIN" run -c "$CONF" >> "$LOG_FILE" 2>&1 &
  PID=$!
  echo "$PID" > "$PID_FILE"

  sleep 1
  if kill -0 "$PID" 2>/dev/null; then
    for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 > "$i" 2>/dev/null || true; done
    for i in /proc/sys/net/ipv4/conf/*/send_redirects; do echo 0 > "$i" 2>/dev/null || true; done
    echo "openbox: started successfully (pid $PID)"
    return 0
  else
    echo "openbox: failed to start, check $LOG_FILE" >&2
    return 1
  fi
}

stop_core_quiet() {
  if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      kill -TERM "$PID" 2>/dev/null || true
      for i in 1 2 3; do
        kill -0 "$PID" 2>/dev/null || break
        sleep 1
      done
      kill -9 "$PID" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
  pkill -x sing-box 2>/dev/null || true
  openbox_clear_mark_rule
  command -v nft >/dev/null 2>&1 && nft delete table $NFT_TABLE >/dev/null 2>&1 || true
}

stop_core() {
  echo "[openbox] Stopping sing-box..."
  stop_core_quiet
  echo "openbox: stopped"
  return 0
}

status_core() {
  if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      state=$(awk '{print $3}' "/proc/$PID/stat" 2>/dev/null || true)
      if [ "$state" != "Z" ]; then
        echo "running (pid $PID)"
        exit 0
      fi
    fi
  fi
  if command -v pidof >/dev/null 2>&1; then
    p=$(pidof sing-box 2>/dev/null | awk '{print $1}')
    if [ -n "$p" ]; then
      echo "running (pid $p)"
      exit 0
    fi
  fi
  alive_pid=$(ps -o pid,stat,comm 2>/dev/null | grep sing-box | grep -v ' Z' | awk '{print $1}' | head -n1)
  if [ -n "$alive_pid" ]; then
    echo "running (pid $alive_pid)"
    exit 0
  fi
  echo "stopped"
  exit 1
}

case "$ACTION" in
  start)
    start_core
    exit $?
    ;;
  stop)
    stop_core
    exit $?
    ;;
  restart)
    stop_core
    start_core
    exit $?
    ;;
  status)
    status_core
    ;;
  enable)
    touch "$AUTOSTART_FILE"
    echo "enabled"
    exit 0
    ;;
  disable)
    rm -f "$AUTOSTART_FILE"
    echo "disabled"
    exit 0
    ;;
  enabled)
    if [ -f "$AUTOSTART_FILE" ]; then
      exit 0
    else
      exit 1
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|enable|disable|enabled}" >&2
    exit 1
    ;;
esac
